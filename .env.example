# Generate random local values and export them before start. Do not commit filled-in copies.
# Empty values are refused. Placeholder words such as replace-me are refused.

NODE_ENV=development
PORT=43117

DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=beekle
DATABASE_PASSWORD=
DATABASE_NAME=beekle_bridge

# fake | bridge_http
BRIDGE_PROVIDER=fake
# sandbox | production
BRIDGE_ENVIRONMENT=sandbox
BRIDGE_ALLOW_PRODUCTION=false
BRIDGE_BASE_URL=https://api.sandbox.bridge.xyz/v0
# Required only for bridge_http. Sandbox keys from the Bridge dashboard start with sk-test.
# Leave empty for the fake provider. Do not commit a real key.
BRIDGE_API_KEY=
BRIDGE_HTTP_TIMEOUT_MS=15000
BRIDGE_HTTP_MAX_ATTEMPTS=3

# PEM public key returned when a Bridge webhook endpoint is created.
# Empty means webhook requests cannot change transfers.
BRIDGE_WEBHOOK_PUBLIC_KEY=
BRIDGE_WEBHOOK_MAX_AGE_MS=600000
BRIDGE_WEBHOOK_FUTURE_SKEW_MS=300000

# local_demo is the labelled fake-provider verifier. It is not a compliance gate.
# Real HTTP mode must stay unconfigured until a trusted verifier exists in the build.
COMPLIANCE_VERIFIER=local_demo
LOCAL_DEMO_APPROVAL_REFS=dec_local_demo
DEPOSIT_INSTRUCTION_STORAGE=redacted

# Required local adapter credentials. Set these in the environment, not in git.
OPERATOR_API_KEY=
MERCHANT_API_KEYS=

# 0 disables the scheduler. The operator endpoint can run one pass.
RECONCILE_INTERVAL_MS=0
